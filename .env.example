# URL base del server di gioco (senza slash finale)
TRAVIAN_SERVER_URL=https://ts1.travian.it

# Credenziali account
TRAVIAN_USERNAME=il_tuo_nick
TRAVIAN_PASSWORD=la_tua_password

# true = browser invisibile, false = finestra visibile (utile in debug)
HEADLESS=true

# Intervallo tra due iterazioni del loop (secondi, distribuzione NON
# uniforme in [min, max] con pause occasionali piu' lunghe — 240-840s
# = un ciclo ogni 4-14 minuti, ritmo plausibile per un utente reale)
LOOP_INTERVAL_MIN=240
LOOP_INTERVAL_MAX=840

# Delay "umani" tra le singole azioni (secondi)
ACTION_DELAY_MIN=0.8
ACTION_DELAY_MAX=2.5

# Numero massimo di costruzioni da tenere in coda contemporaneamente
MAX_BUILD_QUEUE=1

# --- Anti-detection (resilienza stealth) --------------------------------
# Pausa 15-30 min di un modulo dopo esiti SKIPPED/BLOCKED invece di
# riprovare al ciclo successivo (sblocco anticipato se cambiano le risorse)
STEALTH_PAUSES=true
MODULE_PAUSE_MINUTES=15
MODULE_PAUSE_MAX_MINUTES=30

# Sonno notturno: nessuna richiesta per 4-6h al giorno; inizio randomizzato
# di +-1.5h intorno a NIGHT_SLEEP_START_HOUR (ora locale, 0-23)
NIGHT_SLEEP_ENABLED=true
NIGHT_SLEEP_START_HOUR=1
NIGHT_SLEEP_HOURS_MIN=4
NIGHT_SLEEP_HOURS_MAX=6

# Navigazione via click DOM (sidebar villaggi, slot mappa, navbar)
# invece di URL diretti; fallback automatico a page.goto
DOM_NAVIGATION=true

# Se la sessione viene invalidata (login manuale altrove): minuti di pausa
# prima di ritentare il login — mai contesa tra due sessioni
SESSION_CONFLICT_PAUSE_MINUTES=25
