# URL base del server di gioco (senza slash finale)
TRAVIAN_SERVER_URL=https://ts1.travian.it

# Credenziali account
TRAVIAN_USERNAME=il_tuo_nick
TRAVIAN_PASSWORD=la_tua_password

# true = browser invisibile, false = finestra visibile (utile in debug)
HEADLESS=true

# Intervallo tra due iterazioni del loop (secondi, scelto casualmente in [min, max])
LOOP_INTERVAL_MIN=30
LOOP_INTERVAL_MAX=90

# Delay "umani" tra le singole azioni (secondi)
ACTION_DELAY_MIN=0.8
ACTION_DELAY_MAX=2.5

# Numero massimo di costruzioni da tenere in coda contemporaneamente
MAX_BUILD_QUEUE=1
